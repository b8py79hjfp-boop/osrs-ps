[clientscript,tp_chat_tab](string $tab)
// D-096: a custom chat tab (Mentions, Yell, Staff) shows the All view (CHAT_VIEW 0) through the patched filter 193, which
// reads the selected tab from tp_chat_state. The rest repeats the official switch in script 2823 after it sets CHAT_VIEW:
// 553 (its second argument), 223, 2526, 7609, varc 384 = clientclock, 923, 183(view, 0), 178, 84 and 89.
def_int $arg = ~script553;
if_settext($tab, chatbox:tp_chat_state);
%chat_view = 0;
~script223;
def_int $unused = ~script2526;
~script7609;
%buff_bar_dodger_update = clientclock;
~script923;
~script183(0, 0);
~script178;
~script84($arg);
~script89($arg);
