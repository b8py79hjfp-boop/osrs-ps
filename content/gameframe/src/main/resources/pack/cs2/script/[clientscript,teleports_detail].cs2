[clientscript,teleports_detail](component $detail, string $title, string $icon, string $desc, string $info, string $warn)
// Server -> client: the selected destination. An empty $title shows the "choose a destination" hint.
cc_deleteall($detail);
cc_create($detail, ^iftype_rectangle, 0);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setcolour(0x2b2318);
cc_setfill(true);
cc_create($detail, ^iftype_rectangle, 1);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setcolour(0x5a4a35);
cc_setfill(false);
if (string_length($title) = 0) {
    ~teleports_text($detail, 2, 8, 8, 124, 200, p12_full, 0x9f8b6b, "Choose a destination from the list, or search for one.", ^settextalign_centre, ^settextalign_centre);
    return;
}
cc_create($detail, ^iftype_graphic, 2);
cc_setposition(6, 6, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(24, 24, ^setsize_abs, ^setsize_abs);
cc_setgraphic(~teleports_icon($icon));
~teleports_text($detail, 3, 34, 4, 102, 28, p12_full, 0xff981f, $title, ^settextalign_left, ^settextalign_centre);
cc_create($detail, ^iftype_rectangle, 5);
cc_setposition(6, 36, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(128, 1, ^setsize_abs, ^setsize_abs);
cc_setcolour(0x5a4a35);
cc_setfill(true);
~teleports_text($detail, 6, 6, 42, 128, 80, p11_full, 0xffffff, $desc, ^settextalign_left, ^settextalign_top);
~teleports_text($detail, 7, 6, 124, 128, 14, p11_full, 0x9f8b6b, "Location", ^settextalign_left, ^settextalign_top);
~teleports_text($detail, 8, 6, 138, 128, 14, p11_full, 0xffffff, $info, ^settextalign_left, ^settextalign_top);
if (string_length($warn) > 0) {
    cc_create($detail, ^iftype_graphic, 9);
    cc_setposition(6, 168, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(20, 20, ^setsize_abs, ^setsize_abs);
    cc_setgraphic("icon_activities_25x25,2");
    ~teleports_text($detail, 10, 30, 164, 104, 48, p11_full, 0xff4040, $warn, ^settextalign_left, ^settextalign_top);
}
