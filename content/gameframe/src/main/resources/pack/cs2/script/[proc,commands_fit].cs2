[proc,commands_fit](string $text, int $width)(string)
// One-line width: wrapped at 1000 px no row text breaks (a wrap width of 0 measured only the widest word).
def_int $textwidth = parawidth($text, 1000, p11_full);
if ($textwidth <= $width) {
    return($text);
}
def_int $keep = calc(string_length($text) * $width / $textwidth - 2);
if ($keep < 1) {
    $keep = 1;
}
return(append(substring($text, 0, $keep), ".."));
