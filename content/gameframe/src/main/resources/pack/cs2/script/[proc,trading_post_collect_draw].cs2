[proc,trading_post_collect_draw](component $collect, string $text)
cc_deleteall($collect);
cc_create($collect, ^iftype_rectangle, 0);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setcolour(0x5a4a2f);
cc_setfill(true);
cc_create($collect, ^iftype_rectangle, 1);
cc_setposition(1, 1, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(2, 2, ^setsize_minus, ^setsize_minus);
cc_setcolour(0x2b2318);
cc_setfill(true);
cc_create($collect, ^iftype_graphic, 2);
cc_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
cc_setobject_nonum(coins_10000, 1);
cc_create($collect, ^iftype_text, 3);
cc_setposition(42, 4, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(84, 16, ^setsize_abs, ^setsize_abs);
cc_settextfont(p12_full);
cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
cc_settextshadow(true);
cc_setcolour(0xff981f);
cc_settext("Collect");
cc_create($collect, ^iftype_text, 4);
cc_setposition(42, 20, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(84, 16, ^setsize_abs, ^setsize_abs);
cc_settextfont(p11_full);
cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
cc_settextshadow(true);
cc_setcolour(0xffffff);
cc_settext($text);
