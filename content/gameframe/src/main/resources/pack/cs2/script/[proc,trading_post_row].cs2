[proc,trading_post_row](string $data, int $n)(string)
def_int $start = 0;
def_int $i = 0;
while ($i < $n) {
    $start = string_indexof_string($data, "|", $start);
    if ($start = -1) {
        return("");
    }
    $start = calc($start + 1);
    $i = calc($i + 1);
}
def_int $end = string_indexof_string($data, "|", $start);
if ($end = -1) {
    $end = string_length($data);
}
return(substring($data, $start, $end));
