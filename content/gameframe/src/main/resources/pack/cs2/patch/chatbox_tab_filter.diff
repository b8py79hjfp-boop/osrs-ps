# script 193
# base-sha256 f7b3bec58a09ece85800cde31bd9ed844a8038840f75ff9e3f936ee848525a40
# D-096 chatbox tabs. Script 193 decides whether a chat line is shown in the current view (args: int0 type, int1 flags,
# obj0 sender, obj1 text; returns 1 to show). On CHAT_VIEW 0 (All) it shows everything; with a custom tab selected in
# tp_chat_state (162:578) it filters instead:
#   mentions  not a game message, not sent by the viewer, and the text contains the viewer's name (tags removed, any case)
#   yell      a game message whose text, tags removed, starts with "[Yell]" (WorldLinks.yell)
#   staff     a game message whose text, tags removed, starts with "[Staff]" (staff chat)
@@ custom tab filter
LABEL4:
+   iconst                 10617410
+   if_gettext
+   string_length
+   iconst                 0
+   if_icmpeq              TP_F_ALL
+   iconst                 10617410
+   if_gettext
+   sconst                 "mentions"
+   compare
+   iconst                 0
+   if_icmpne              TP_F_YELL
+   iload                  0
+   iconst                 0
+   if_icmpeq              TP_F_HIDE
+   chat_playername
+   string_length
+   iconst                 0
+   if_icmpeq              TP_F_HIDE
+   oload                  0
+   removetags
+   lowercase
+   chat_playername
+   removetags
+   lowercase
+   compare
+   iconst                 0
+   if_icmpeq              TP_F_HIDE
+   oload                  1
+   removetags
+   lowercase
+   chat_playername
+   removetags
+   lowercase
+   iconst                 0
+   string_indexof_string
+   iconst                 -1
+   if_icmpeq              TP_F_HIDE
+   iconst                 1
+   return
+TP_F_YELL:
+   iconst                 10617410
+   if_gettext
+   sconst                 "yell"
+   compare
+   iconst                 0
+   if_icmpne              TP_F_STAFF
+   iload                  0
+   iconst                 0
+   if_icmpne              TP_F_HIDE
+   oload                  1
+   removetags
+   sconst                 "[Yell]"
+   iconst                 0
+   string_indexof_string
+   iconst                 0
+   if_icmpne              TP_F_HIDE
+   iconst                 1
+   return
+TP_F_STAFF:
+   iload                  0
+   iconst                 0
+   if_icmpne              TP_F_HIDE
+   oload                  1
+   removetags
+   sconst                 "[Staff]"
+   iconst                 0
+   string_indexof_string
+   iconst                 0
+   if_icmpne              TP_F_HIDE
+   iconst                 1
+   return
+TP_F_HIDE:
+   iconst                 0
+   return
+TP_F_ALL:
   iconst                 1
   return
