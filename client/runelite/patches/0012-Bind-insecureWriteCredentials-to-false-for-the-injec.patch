From 2862782eab76ac1e832deac61028b29aef80b7a9 Mon Sep 17 00:00:00 2001
From: tickperfect <dev@tickperfect.invalid>
Date: Fri, 6 Nov 2026 09:33:02 +0000
Subject: [PATCH] Bind insecureWriteCredentials to false for the injected
 client

---
 .../src/main/java/net/runelite/client/RuneLiteModule.java      | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/runelite-client/src/main/java/net/runelite/client/RuneLiteModule.java b/runelite-client/src/main/java/net/runelite/client/RuneLiteModule.java
index d83eae3..46ca970 100644
--- a/runelite-client/src/main/java/net/runelite/client/RuneLiteModule.java
+++ b/runelite-client/src/main/java/net/runelite/client/RuneLiteModule.java
@@ -117,6 +117,9 @@ public class RuneLiteModule extends AbstractModule
 		}
 
 		bindConstant().annotatedWith(Names.named("developerMode")).to(developerMode);
+		// The injected game client injects this flag (it gated writing Jagex launcher credentials to disk). The fork
+		// removed that feature with Jagex Account login, so it is always off; the binding must still exist.
+		bindConstant().annotatedWith(Names.named("insecureWriteCredentials")).to(false);
 		bindConstant().annotatedWith(Names.named("safeMode")).to(safeMode);
 		bindConstant().annotatedWith(Names.named("disableTelemetry")).to(disableTelemetry);
 		bind(File.class).annotatedWith(Names.named("sessionfile")).toInstance(sessionfile);
-- 
