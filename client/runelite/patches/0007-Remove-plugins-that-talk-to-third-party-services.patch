-			client.runScript(listener);
-
-			w.getParent().deleteAllChildren();
-		}
-
-		w = client.getWidget(InterfaceID.Bankmain.NEXT_PAGE);
-		if (w != null)
-		{
-			var listener = w.getOnLoadListener();
-			client.runScript(listener);
-
-			w.getParent().deleteAllChildren();
-		}
-	}
