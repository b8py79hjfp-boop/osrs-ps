-		}
-		catch (AEADBadTagException e)
-		{
-			throw new IOException("incorrect key or corrupt encrypted data", e);
-		}
-		catch (GeneralSecurityException e)
-		{
-			throw new IOException("unable to decrypt data", e);
-		}
