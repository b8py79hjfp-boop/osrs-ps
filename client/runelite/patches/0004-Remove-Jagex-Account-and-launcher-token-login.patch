-		if (!sessions.isEmpty())
-		{
-			add(sessionList);
-		}
-		add(actions);
-		add(infoLabel);
-
-		revalidate();
-		repaint();
-	}
-
-	private void addAccount()
-	{
-		addAccountButton.setEnabled(false);
-		new Thread(() ->
-		{
-			try
