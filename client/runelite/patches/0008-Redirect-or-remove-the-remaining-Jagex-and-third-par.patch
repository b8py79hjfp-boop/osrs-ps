@@ -145,4 +175,28 @@ public class RuneLiteProperties
 	{
 		return properties.getProperty(JAGEX_DOMAINBLOCK).split(",");
 	}
+
+	/**
+	 * Whether the client may contact the host. Only the hosts of the release's own services (site, API, static,
+	 * config, session and websocket URLs, and loopback) are allowed; every other host is refused by the HTTP client, so no request
+	 * can reach Jagex, RuneLite or any other third party even if some code path still builds such a URL.
+	 */
+	public static boolean isReleaseHost(String host)
+	{
+		// Loopback never leaves the machine (and is what the client tests' mock servers use)
+		if (host.equalsIgnoreCase("localhost") || host.equals("127.0.0.1") || host.equals("::1"))
+		{
+			return true;
+		}
+
+		for (String key : RELEASE_HOST_PROPERTIES)
+		{
+			final HttpUrl url = HttpUrl.parse(properties.getProperty(key, ""));
+			if (url != null && url.host().equalsIgnoreCase(host))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
 }
