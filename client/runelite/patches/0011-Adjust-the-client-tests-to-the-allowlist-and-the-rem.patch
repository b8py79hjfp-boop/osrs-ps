From: tickperfect fork <fork@localhost>
Date: Fri, 6 Nov 2026 09:24:00 +0000
Subject: [PATCH] Adjust the client tests to the allowlist and the removed
 classes

---
 .../src/test/java/net/runelite/client/OkHttpTest.java    | 2 +-
 .../net/runelite/client/plugins/PluginManagerTest.java   | 9 +++++++++
 .../client/plugins/xptracker/XpTrackerPluginTest.java    | 4 ----
 3 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/runelite-client/src/test/java/net/runelite/client/OkHttpTest.java b/runelite-client/src/test/java/net/runelite/client/OkHttpTest.java
index 92849fd..52c7616 100644
--- a/runelite-client/src/test/java/net/runelite/client/OkHttpTest.java
+++ b/runelite-client/src/test/java/net/runelite/client/OkHttpTest.java
@@ -133,6 +133,6 @@ public class OkHttpTest
 			.newCall(request).execute().close();
 
 		// rest of UA depends on if git is found
-		assertTrue(server.takeRequest().getHeader("User-Agent").startsWith("RuneLite/" + RuneLiteProperties.getVersion()));
+		assertTrue(server.takeRequest().getHeader("User-Agent").startsWith(RuneLiteProperties.getTitle() + "/" + RuneLiteProperties.getVersion()));
 	}
 }
diff --git a/runelite-client/src/test/java/net/runelite/client/plugins/PluginManagerTest.java b/runelite-client/src/test/java/net/runelite/client/plugins/PluginManagerTest.java
index d91c415..be8ef90 100644
--- a/runelite-client/src/test/java/net/runelite/client/plugins/PluginManagerTest.java
+++ b/runelite-client/src/test/java/net/runelite/client/plugins/PluginManagerTest.java
@@ -40,10 +40,12 @@ import java.io.File;
 import java.io.IOException;
 import java.io.PrintWriter;
 import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
 import java.util.HashSet;
 import java.util.List;
 import java.util.Objects;
 import java.util.Set;
+import java.util.stream.Collectors;
 import net.runelite.api.Client;
 import net.runelite.client.RuneLite;
 import net.runelite.client.RuneLiteModule;
@@ -147,7 +149,14 @@ public class PluginManagerTest
 		EventBus eventBus = new EventBus();
 		plugins.forEach(eventBus::register);
 
+		// Only allowlisted plugins are loaded
+		var allowlist = new String(PluginManager.class.getResourceAsStream("allowlist.txt").readAllBytes(), StandardCharsets.UTF_8)
+			.lines()
+			.map(String::trim)
+			.filter(l -> !l.isEmpty() && l.charAt(0) != '#')
+			.collect(Collectors.toSet());
 		var expected = pluginClasses.stream()
+			.filter(cl -> allowlist.contains(cl.getName()))
 			.map(cl -> cl.getAnnotation(PluginDescriptor.class))
 			.filter(Objects::nonNull)
 			.filter(pd -> !pd.developerPlugin())
diff --git a/runelite-client/src/test/java/net/runelite/client/plugins/xptracker/XpTrackerPluginTest.java b/runelite-client/src/test/java/net/runelite/client/plugins/xptracker/XpTrackerPluginTest.java
index 7edbb05..8eec059 100644
--- a/runelite-client/src/test/java/net/runelite/client/plugins/xptracker/XpTrackerPluginTest.java
+++ b/runelite-client/src/test/java/net/runelite/client/plugins/xptracker/XpTrackerPluginTest.java
@@ -69,10 +69,6 @@ public class XpTrackerPluginTest
 	@Bind
 	private XpTrackerConfig xpTrackerConfig;
 
-	@Mock
-	@Bind
-	private XpClient xpClient;
-
 	@Mock
 	@Bind
 	private OverlayManager overlayManager;
