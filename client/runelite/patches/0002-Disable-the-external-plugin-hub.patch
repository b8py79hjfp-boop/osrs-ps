From 60d5aad30dac59a446366521b57d59b31876dd64 Mon Sep 17 00:00:00 2001
From: tickperfect fork <fork@localhost>
Date: Fri, 6 Nov 2026 09:23:59 +0000
Subject: [PATCH] Disable the external plugin hub

---
 .../externalplugins/ExternalPluginClient.java | 17 ++++++++++-
 .../ExternalPluginManager.java                | 16 +++++-----
 .../plugins/config/TopLevelConfigPanel.java   |  2 +-
 .../externalplugins/externalplugins.crt       | 30 -------------------
 4 files changed, 26 insertions(+), 39 deletions(-)
 delete mode 100644 runelite-client/src/main/resources/net/runelite/client/externalplugins/externalplugins.crt

diff --git a/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginClient.java b/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginClient.java
index 234f93b..65e4e81 100644
--- a/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginClient.java
+++ b/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginClient.java
@@ -90,6 +90,11 @@ public class ExternalPluginClient
 
 	private <T> T downloadManifest(String name, Class<T> clazz) throws IOException, VerificationException
 	{
+		if (true)
+		{
+			throw new IOException("The plugin hub is disabled");
+		}
+
 		HttpUrl manifest = pluginHubBase
 			.newBuilder()
 			.addPathSegment("manifest")
@@ -127,6 +132,11 @@ public class ExternalPluginClient
 
 	public BufferedImage downloadIcon(PluginHubManifest.DisplayData plugin) throws IOException
 	{
+		if (true)
+		{
+			throw new IOException("The plugin hub is disabled");
+		}
+
 		if (plugin.getIconHash() == null)
 		{
 			return null;
@@ -173,7 +183,7 @@ public class ExternalPluginClient
 
 	void submitPlugins(List<String> plugins)
 	{
-		if (plugins.isEmpty())
+		if (true || plugins.isEmpty())
 		{
 			return;
 		}
@@ -206,6 +216,11 @@ public class ExternalPluginClient
 
 	public Map<String, Integer> getPluginCounts() throws IOException
 	{
+		if (true)
+		{
+			throw new IOException("The plugin hub is disabled");
+		}
+
 		HttpUrl url = apiBase
 			.newBuilder()
 			.addPathSegments("pluginhub")
diff --git a/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginManager.java b/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginManager.java
index 099d669..c2d66e5 100644
--- a/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginManager.java
+++ b/runelite-client/src/main/java/net/runelite/client/externalplugins/ExternalPluginManager.java
@@ -44,10 +44,8 @@ import java.util.Collection;
 import java.util.HashSet;
 import java.util.List;
 import java.util.Map;
-import java.util.Random;
 import java.util.Set;
 import java.util.concurrent.ScheduledExecutorService;
-import java.util.concurrent.TimeUnit;
 import java.util.function.Function;
 import javax.annotation.Nullable;
 import javax.inject.Inject;
@@ -79,6 +77,7 @@ import okhttp3.Response;
 public class ExternalPluginManager
 {
 	private static final String PLUGIN_LIST_KEY = "externalPlugins";
+	private static final boolean HUB_DISABLED = true;
 	private static Class<? extends Plugin>[] builtinExternals = null;
 
 	@Inject
@@ -111,15 +110,11 @@ public class ExternalPluginManager
 		this.eventBus = eventBus;
 		this.okHttpClient = okHttpClient;
 		this.gson = gson;
-
-		executor.scheduleWithFixedDelay(() -> externalPluginClient.submitPlugins(getInstalledExternalPlugins()),
-			new Random().nextInt(60), 180, TimeUnit.MINUTES);
 	}
 
 	public void loadExternalPlugins() throws PluginInstantiationException
 	{
-		refreshPlugins();
-
+		// The plugin hub is disabled in this build: nothing is downloaded, and no hub plugin is ever loaded.
 		if (builtinExternals != null)
 		{
 			// builtin external's don't actually have a manifest or a separate classloader...
@@ -135,6 +130,13 @@ public class ExternalPluginManager
 
 	private void refreshPlugins()
 	{
+		// The plugin hub is disabled in this build; see ExternalPluginClient.
+		if (HUB_DISABLED)
+		{
+			log.debug("The plugin hub is disabled");
+			return;
+		}
+
 		if (safeMode)
 		{
 			log.debug("External plugins are disabled in safe mode!");
diff --git a/runelite-client/src/main/java/net/runelite/client/plugins/config/TopLevelConfigPanel.java b/runelite-client/src/main/java/net/runelite/client/plugins/config/TopLevelConfigPanel.java
index f9585c3..44270fc 100644
--- a/runelite-client/src/main/java/net/runelite/client/plugins/config/TopLevelConfigPanel.java
+++ b/runelite-client/src/main/java/net/runelite/client/plugins/config/TopLevelConfigPanel.java
@@ -84,7 +84,7 @@ class TopLevelConfigPanel extends PluginPanel
 
 		addTab(profilePanel, "profile_icon.png", "Profiles");
 
-		addTab(pluginHubPanelProvider, "plugin_hub_icon.png", "Plugin Hub");
+		// The plugin hub is disabled in this build, so it gets no tab.
 
 		tabGroup.select(pluginListPanelTab);
 	}
diff --git a/runelite-client/src/main/resources/net/runelite/client/externalplugins/externalplugins.crt b/runelite-client/src/main/resources/net/runelite/client/externalplugins/externalplugins.crt
deleted file mode 100644
index b47c675..0000000
--- a/runelite-client/src/main/resources/net/runelite/client/externalplugins/externalplugins.crt
+++ /dev/null
@@ -1,30 +0,0 @@
