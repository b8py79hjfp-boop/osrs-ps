root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_function_naming_ignore_when_annotated_with = Test

[*.{yml,yaml,json,toml}]
indent_size = 2
